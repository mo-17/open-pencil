{
  "name": "@open-pencil/mcp",
  "version": "0.15.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "openpencil-mcp": "./dist/stdio.mjs",
    "openpencil-mcp-http": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/server.mjs",
  "imports": {
    "#mcp/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./stdio": {
      "types": "./dist/stdio.d.mts",
      "import": "./dist/stdio.mjs",
      "default": "./dist/stdio.mjs"
    },
    "./transport": {
      "types": "./dist/transport.d.mts",
      "bun": "./src/transport/paths.ts",
      "import": "./dist/transport.mjs",
      "default": "./dist/transport.mjs"
    },
    "./discovery": {
      "types": "./dist/discovery.d.mts",
      "bun": "./src/transport/discovery.ts",
      "import": "./dist/discovery.mjs",
      "default": "./dist/discovery.mjs"
    },
    "./motion-export": {
      "types": "./dist/motion-export.d.mts",
      "bun": "./src/motion-export/index.ts",
      "import": "./dist/motion-export.mjs",
      "default": "./dist/motion-export.mjs"
    },
    "./plugin-contract": {
      "types": "./dist/plugin-contract.d.mts",
      "bun": "./src/tool/plugin/contract.ts",
      "import": "./dist/plugin-contract.mjs",
      "default": "./dist/plugin-contract.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/plugin-contracts": "workspace:*",
    "hono": "^4.12.5",
    "package-manager-detector": "^1.6.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/ws": "^8.18.1"
  }
}
