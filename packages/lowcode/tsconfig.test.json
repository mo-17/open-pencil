{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "#lowcode/*": ["./src/*"],
      "@open-pencil/lowcode": ["./src/index.ts"],
      "@open-pencil/lowcode/application-runtime": ["./src/application-runtime.ts"],
      "@open-pencil/lowcode/backend": ["./src/backend/index.ts"],
      "#tests/*": ["../../tests/*"]
    },
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
