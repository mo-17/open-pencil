{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "bun"],
    "paths": {
      "#compiler/*": ["./src/*"],
      "#core/*": ["../core/src/*"],
      "@open-pencil/core": ["../core/src/index.ts"],
      "@open-pencil/core/*": ["../core/src/*"]
    },
    "noCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
