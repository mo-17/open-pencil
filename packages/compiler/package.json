{
  "name": "@open-pencil/compiler",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#compiler/*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./ir/*": {
      "types": "./src/ir/*.ts",
      "bun": "./src/ir/*.ts",
      "default": "./dist/ir/*.mjs"
    },
    "./adapters/react": {
      "types": "./src/adapters/react/index.ts",
      "bun": "./src/adapters/react/index.ts",
      "default": "./dist/adapters/react/index.mjs"
    },
    "./adapters/react/*": {
      "types": "./src/adapters/react/*.ts",
      "bun": "./src/adapters/react/*.ts",
      "default": "./dist/adapters/react/*.mjs"
    },
    "./dev-server": {
      "types": "./src/dev-server.ts",
      "bun": "./src/dev-server.ts",
      "default": "./dist/dev-server.mjs"
    },
    "./vfs": {
      "types": "./src/vfs.ts",
      "bun": "./src/vfs.ts",
      "default": "./dist/vfs.mjs"
    },
    "./build": {
      "types": "./src/build.ts",
      "bun": "./src/build.ts",
      "default": "./dist/build.mjs"
    },
    "./deploy": {
      "types": "./src/deploy.ts",
      "bun": "./src/deploy.ts",
      "default": "./dist/deploy.mjs"
    },
    "./theme-css": {
      "types": "./src/theme-css.ts",
      "bun": "./src/theme-css.ts",
      "default": "./dist/theme-css.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.94",
    "@noble/hashes": "^1.8.0",
    "@open-pencil/core": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^7.1.0",
    "zustand": "^5.0.0"
  }
}
