{
  "name": "@open-pencil/codepen-sidecar",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "imports": {
    "#vue-compiler-sfc-browser": {
      "types": "@vue/compiler-sfc",
      "default": "@vue/compiler-sfc/dist/compiler-sfc.esm-browser.js"
    }
  },
  "scripts": {
    "build": "tsgo --noEmit -p tsconfig.json",
    "build:binary": "bun scripts/build.ts",
    "lint": "oxlint -c ../../oxlint.json --type-aware --type-check --tsconfig=tsconfig.json src scripts tests",
    "smoke:binary": "bun scripts/smoke.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@open-pencil/compiler": "workspace:*",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/lowcode": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "@vue/compiler-sfc": "^3.5.29",
    "tailwindcss": "4.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.3.2",
    "@typescript/native-preview": "^7.0.0-dev.20260228.1"
  }
}
