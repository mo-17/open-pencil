{
  "name": "@open-pencil/motion-runtime",
  "version": "0.13.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/motion-runtime"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    },
    "./drivers": {
      "types": "./dist/drivers.d.ts",
      "import": "./dist/drivers.js",
      "default": "./dist/drivers.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js",
      "default": "./dist/kernel.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "default": "./dist/vanilla.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepack": "bun run build",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.3",
    "typescript": "~5.8.3",
    "vue": "^3.5.29"
  },
  "peerDependencies": {
    "@open-pencil/core": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
