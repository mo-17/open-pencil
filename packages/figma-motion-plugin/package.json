{
  "name": "@open-pencil/figma-motion-plugin",
  "version": "0.13.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/code.ts --outfile dist/code.js --target browser --format iife --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
