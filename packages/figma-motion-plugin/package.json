  },
  "dependencies": {
    "@open-pencil/fig": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.131.0",
    "@types/bun": "^1.3.14",
    "typescript": "~5.8.3"
  }
}
