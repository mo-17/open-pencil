{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings"],
    "paths": {
      "@open-pencil/fig": ["../fig/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
