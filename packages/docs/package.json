{
  "name": "@open-pencil/docs",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#docs/*": "./.vitepress/*"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "DOCS_TWOSLASH=0 bun run build:site",
    "build:production": "OPENPENCIL_LANDING_POSTERS=1 bun run build:site && bun run build:llms && bun ../../tools/generate/landing-posters/src/generate.ts",
    "check": "bun ../../tools/checks/docs/src/check.ts",
    "preview": "vitepress preview",
    "build:site": "bun .vitepress/build/site.ts",
    "build:partition": "vitepress build",
    "build:llms": "bun .vitepress/llms/build.ts",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.98",
    "@open-pencil/brand-tools": "workspace:*",
    "@open-pencil/cli": "workspace:*",
    "@open-pencil/demo-tools": "workspace:*",
    "@open-pencil/feedback": "workspace:*",
    "@open-pencil/landing-posters-tools": "workspace:*",
    "@open-pencil/vite-config": "workspace:*",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "unist-util-remove": "^4.0.0",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-llms": "1.12.2",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.10"
  },
  "dependencies": {
    "@ai-sdk/vue": "^4.0.127",
    "@iconify/vue": "^5.0.1",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/design-jsx": "workspace:*",
    "@open-pencil/dom-css": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "ai": "^7.0.127",
    "canvaskit-wasm": "^0.41.1",
    "dedent": "^1.7.2",
    "es-toolkit": "^1.52.0",
    "tinykeys": "^3.1.0",
    "valibot": "^1.5.0"
  }
}
