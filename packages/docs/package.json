{
  "name": "@open-pencil/docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#docs/*": "./.vitepress/*"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "DOCS_TWOSLASH=0 bun run build:site",
    "build:site": "bun .vitepress/build/site.ts",
    "build:partition": "vitepress build",
    "build:llms": "bun .vitepress/llms/build.ts",
    "build:production": "bun run build:site && bun run build:llms",
    "check": "bun ../../tools/docs/src/check.ts",
    "preview": "vitepress preview",
    "test": "bun test tests"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1"
  },
  "devDependencies": {
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "unist-util-remove": "^4.0.0",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-llms": "1.12.2",
    "vue": "^3.5.41",
    "vue-component-meta": "^3.3.10"
  }
}
