{
  "name": "@open-pencil/motion",
  "version": "0.15.0",
  "description": "Framework-agnostic deterministic Motion planning, sampling, projection, and continuous-driver primitives for OpenPencil.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-pencil/open-pencil.git",
    "directory": "packages/motion"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bunx tsdown --config tsdown.config.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run smoke:dist",
    "prepack": "bun run build",
    "smoke:dist": "bun scripts/smoke-dist.ts",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "@open-pencil/scene-graph": "workspace:*"
  }
}
