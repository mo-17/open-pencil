{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-text",
    "allow-acp-process-environment",
    "allow-aliyun-drive-oauth-authorize",
    "allow-aliyun-drive-oauth-cancel",
    "allow-aliyun-drive-oauth-refresh",
    "allow-aliyun-drive-transfer",
    "allow-baidu-netdisk-oauth-authorize",
    "allow-baidu-netdisk-oauth-cancel",
    "allow-baidu-netdisk-oauth-refresh",
    "allow-baidu-netdisk-transfer",
    "allow-build-fig-file",
    "allow-close-ai-window",
    "allow-credential-access-paused",
    "allow-credential-read",
    "allow-credential-remove",
    "allow-credential-retry-access",
    "allow-credential-status",
    "allow-credential-store-availability",
    "allow-credential-write",
    "allow-commit-source-export-file",
    "allow-fetch-codepen-sources",
    "allow-google-drive-oauth-authorize",
    "allow-google-drive-oauth-cancel",
    "allow-google-drive-oauth-refresh",
    "allow-google-drive-oauth-revoke",
    "allow-google-drive-transfer",
    "allow-onedrive-oauth-authorize",
    "allow-onedrive-oauth-cancel",
    "allow-onedrive-oauth-refresh",
    "allow-onedrive-transfer",
    "allow-mcp-lookup",
    "allow-close-preview-window",
    "allow-list-system-fonts",
    "allow-load-system-font",
    "allow-native-menu-checked",
    "allow-open-ai-window",
    "allow-open-codepen-prefill",
    "allow-path-matches-suffix",
    "allow-proxy-http-request",
    "allow-open-preview-window",
    "allow-set-native-menu-checked",
    "allow-set-recent-files",
    "allow-supabase-database-read-credential-clear-v1",
    "allow-supabase-database-read-credential-replace-v1",
    "allow-supabase-database-read-credential-status-v1",
    "allow-supabase-management-inspect-pg-catalog-v1",
    "allow-take-pending-open",
    "allow-update-ai-window",
    "allow-update-preview-window",
    "allow-write-motion-export-noclobber",
    "fs:deny-default",
    {
      "identifier": "fs:scope",
      "deny": [
        {
          "path": "$HOME/Library/LaunchAgents"
        },
        {
          "path": "$HOME/Library/LaunchAgents/**"
        },
        {
          "path": "$DATA/Microsoft/Windows/Start Menu/Programs/Startup"
        },
        {
          "path": "$DATA/Microsoft/Windows/Start Menu/Programs/Startup/**"
        },
        {
          "path": "$DOCUMENT/PowerShell"
        },
        {
          "path": "$DOCUMENT/PowerShell/**"
        },
        {
          "path": "$DOCUMENT/WindowsPowerShell"
        },
        {
          "path": "$DOCUMENT/WindowsPowerShell/**"
        },
        {
          "path": "/usr/local"
        },
        {
          "path": "/usr/local/**"
        },
        {
          "path": "/opt/homebrew"
        },
        {
          "path": "/opt/homebrew/**"
        },
        {
          "path": "$HOME/bin"
        },
        {
          "path": "$HOME/bin/**"
        },
        {
          "path": "$HOME/n"
        },
        {
          "path": "$HOME/n/**"
        },
        {
          "path": "$DATA/npm"
        },
        {
          "path": "$DATA/npm/**"
        },
        {
          "path": "$DATA/nvm"
        },
        {
          "path": "$DATA/nvm/**"
        },
        {
          "path": "$DATA/fnm"
        },
        {
          "path": "$DATA/fnm/**"
        },
        {
          "path": "$LOCALDATA/Volta"
        },
        {
          "path": "$LOCALDATA/Volta/**"
        },
        {
          "path": "$LOCALDATA/Programs"
        },
        {
          "path": "$LOCALDATA/Programs/**"
        },
        {
          "path": "$LOCALDATA/Microsoft/WindowsApps"
        },
        {
          "path": "$LOCALDATA/Microsoft/WindowsApps/**"
        },
        {
          "path": "$HOME/scoop"
        },
        {
          "path": "$HOME/scoop/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        },
        {
          "path": "$HOME/.openpencil/mcp.json"
        }
      ]
    },
    "fs:allow-fstat",
    "fs:allow-seek",
    "fs:allow-read",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.pi/agent/settings.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        },
        {
          "path": "$HOME/.openpencil/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        },
        {
          "path": "$HOME/.openpencil/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.pi/agent/auth.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        },
        {
          "path": "$HOME/.openpencil/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        },
        {
          "path": "$HOME/.openpencil/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "fs:allow-unwatch",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-agent-acp",
          "cmd": "claude-agent-acp",
          "args": false
        },
        {
          "name": "codex-acp",
          "cmd": "codex-acp",
          "args": false
        },
        {
          "name": "gemini",
          "cmd": "gemini",
          "args": ["--acp"]
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": [
            "install",
            "--global",
            {
              "validator": "^(@agentclientprotocol/(claude-agent-acp|codex-acp)|@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?)$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "bun",
          "cmd": "bun",
          "args": [
            "add",
            "--global",
            {
              "validator": "^@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "openpencil-mcp-http",
          "cmd": "openpencil-mcp-http",
          "args": false
        },
        {
          "name": "openpencil-harness",
          "cmd": "openpencil-harness",
          "args": false
        },
        {
          "name": "cmd-claude-agent-acp",
          "cmd": "cmd",
          "args": ["/c", "claude-agent-acp"]
        },
        {
          "name": "cmd-codex-acp",
          "cmd": "cmd",
          "args": ["/c", "codex-acp"]
        },
        {
          "name": "cmd-gemini",
          "cmd": "cmd",
          "args": ["/c", "gemini", "--acp"]
        },
        {
          "name": "cmd-npm",
          "cmd": "cmd",
          "args": [
            "/c",
            "npm",
            "install",
            "--global",
            {
              "validator": "^(@agentclientprotocol/(claude-agent-acp|codex-acp)|@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?)$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "cmd-bun",
          "cmd": "cmd",
          "args": [
            "/c",
            "bun",
            "add",
            "--global",
            {
              "validator": "^@open-pencil/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "cmd-openpencil-mcp-http",
          "cmd": "cmd",
          "args": ["/c", "openpencil-mcp-http"]
        },
        {
          "name": "cmd-openpencil-harness",
          "cmd": "cmd",
          "args": ["/c", "openpencil-harness"]
        },
        {
          "name": "openpencil-mcp",
          "cmd": "openpencil-mcp",
          "args": false
        },
        {
          "name": "cmd-openpencil-mcp",
          "cmd": "cmd",
          "args": ["/c", "openpencil-mcp"]
        },
        {
          "name": "lowcode-preview",
          "cmd": "bun",
          "args": [
            "packages/compiler/src/dev-server.ts",
            "--root",
            {
              "validator": "^[^\\x00-\\x1F]{1,4096}$"
            },
            "--target",
            {
              "validator": "^(react|vue)$"
            }
          ]
        },
        {
          "name": "lowcode-preview-local-backend",
          "cmd": "bun",
          "args": [
            "packages/compiler/src/dev-server.ts",
            "--root",
            {
              "validator": "^[^\\x00-\\x1F]{1,4096}$"
            },
            "--target",
            {
              "validator": "^(react|vue)$"
            },
            "--local-backend",
            {
              "validator": "^\\{[^\\x00-\\x1F]{1,16384}\\}$"
            }
          ]
        },
        {
          "name": "lowcode-managed-preview",
          "cmd": "bun",
          "args": [
            "packages/compiler/src/managed-preview/cli.ts",
            "--session",
            {
              "validator": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            }
          ]
        },
        {
          "name": "lowcode-microfrontend",
          "cmd": "bun",
          "args": [
            "tools/dev/lowcode/src/native-cli.ts",
            "build",
            {
              "validator": "^\\[[^\\x00-\\x1F]{1,32768}\\]$"
            }
          ]
        },
        {
          "name": "lowcode-deploy",
          "cmd": "bun",
          "args": [
            "tools/dev/lowcode/src/native-cli.ts",
            "deploy",
            {
              "validator": "^\\[[^\\x00-\\x1F]{1,32768}\\]$"
            }
          ]
        },
        {
          "name": "flutter-preview",
          "cmd": "bun",
          "args": ["tools/dev/flutter-preview/src/index.ts"]
        },
        {
          "name": "binaries/openpencil-codepen-sidecar",
          "sidecar": true,
          "args": false
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "allow-agent-lookup",
    "allow-cancel-http-request",
    "allow-sharing-disabled-by-env",
    "allow-take-pending-rooms",
    "allow-webview-version"
  ]
}
