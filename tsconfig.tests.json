{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "#vite-config/*": [
        "./vite/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "#vue/*": [
        "./packages/vue/src/*",
        "./packages/vue/src/*.vue"
      ],
      "#core/*": [
        "./packages/core/src/*"
      ],
      "#fig/*": [
        "./packages/fig/src/*"
      ],
      "#cli/*": [
        "./packages/cli/src/*"
      ],
      "#mcp/*": [
        "./packages/mcp/src/*"
      ],
      "@open-pencil/harness": [
        "./packages/harness/src/index.ts"
      ],
      "#feedback/*": [
        "./packages/feedback/src/*"
      ],
      "#dom-css/*": [
        "./packages/dom-css/src/*"
      ],
      "#tests/*": [
        "./tests/*"
      ],
      "#docs-config/*": [
        "./packages/docs/.vitepress/*"
      ],
      "#docs/*": [
        "./packages/docs/.vitepress/*"
      ],
      "tinykeys": [
        "./node_modules/tinykeys/dist/tinykeys.d.ts"
      ],
      "@open-pencil/cli/library": [
        "./packages/cli/src/library/index.ts"
      ],
      "@open-pencil/dom-css": [
        "./packages/dom-css/src/index.ts"
      ],
      "@open-pencil/dom-css/scene-graph": [
        "./packages/dom-css/src/import/scene-graph.ts"
      ],
      "@open-pencil/dom-css/export": [
        "./packages/dom-css/src/export/index.ts"
      ],
      "@open-pencil/dom-css/*": [
        "./packages/dom-css/src/*"
      ],
      "#scene-graph/*": [
        "./packages/scene-graph/src/*"
      ],
      "@open-pencil/scene-graph": [
        "./packages/scene-graph/src/index.ts"
      ],
      "@open-pencil/scene-graph/*": [
        "./packages/scene-graph/src/*"
      ],
      "#emit/*": [
        "./packages/emit/src/*"
      ],
      "@open-pencil/emit": [
        "./packages/emit/src/index.ts"
      ],
      "#design-jsx/*": [
        "./packages/design-jsx/src/*"
      ],
      "@open-pencil/design-jsx": [
        "./packages/design-jsx/src/index.ts"
      ],
      "#pen/*": [
        "./packages/pen/src/*"
      ],
      "@open-pencil/pen": [
        "./packages/pen/src/index.ts"
      ],
      "@open-pencil/pen/*": [
        "./packages/pen/src/*"
      ],
      "#core-assets/*": [
        "./packages/core/assets/*"
      ],
      "#compiler/*": [
        "./packages/compiler/src/*"
      ],
      "#lowcode/*": [
        "./packages/lowcode/src/*"
      ],
      "#codepen-sidecar/*": [
        "./packages/codepen-sidecar/*"
      ],
      "#tools/*": [
        "./tools/*"
      ],
      "#vite/*": [
        "./vite/*"
      ],
      "@open-pencil/compiler": [
        "./packages/compiler/src/index.ts"
      ],
      "@open-pencil/compiler/preview-local-backend": [
        "./packages/compiler/src/local-backend-preview/connection.ts"
      ],
      "@open-pencil/compiler/managed-preview": [
        "./packages/compiler/src/managed-preview/protocol.ts"
      ],
      "@open-pencil/compiler/*": [
        "./packages/compiler/src/*"
      ],
      "@open-pencil/lowcode": [
        "./packages/lowcode/src/index.ts"
      ],
      "@open-pencil/lowcode/*": [
        "./packages/lowcode/src/*"
      ],
      "@open-pencil/motion": [
        "./packages/motion/src/index.ts"
      ],
      "@open-pencil/plugin-contracts": [
        "./packages/plugin-contracts/src/index.ts"
      ],
      "@open-pencil/plugin-contracts/adapter-helpers": [
        "./packages/plugin-contracts/src/adapter-helpers.ts"
      ],
      "#authoring-reference/*": [
        "./tools/generate/authoring-reference/src/*"
      ],
      "#ci/*": [
        "./tools/ci/policy/src/*"
      ],
      "#core-tests/*": [
        "./packages/core/tests/*"
      ],
      "#fig-tests/*": [
        "./packages/fig/tests/*"
      ],
      "#cli-tests/*": [
        "./packages/cli/tests/*"
      ],
      "/src/*": [
        "./src/*"
      ],
      "/packages/*": [
        "./packages/*"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "packages/core/src/global.d.ts",
    "packages/vue/src/global.d.ts",
    "packages/dom-css/src/cssom.d.ts",
    "packages/dom-css/src/postcss-value-parser.d.ts",
    "packages/design-jsx/src/global.d.ts",
    "tests/**/*.ts",
    "packages/*/tests/**/*.ts"
  ],
  "exclude": [
    "tests/e2e/native/**",
    "packages/feedback/**",
    "tests/e2e/native-collab/**",
    "tests/helpers/tauri/native-global.d.ts",
    "tests/helpers/tauri/invoke.ts",
    "tests/helpers/tauri/os.ts",
    "tests/helpers/tauri/windows-input.ts",
    "tests/helpers/tauri/editor-ready.ts",
    "tests/helpers/tauri/editor-snapshot.ts",
    "tests/helpers/tauri/event-recorder.ts"
  ]
}
