    "lint:structure": "oxlint -c oxlint.json commitlint.config.ts vite.config.ts vite/ .storybook/ src/ packages/scene-graph/src/ packages/scene-graph/scripts/ packages/core/src/ packages/vue/src/ packages/cli/src/ packages/mcp/src/ packages/harness/src/ packages/harness/tests/ packages/feedback/src/ packages/feedback/tests/ packages/dom-css/src/ packages/dom-css/tests/ packages/dom-css/scripts/ packages/pen/src/ packages/pen/scripts/ packages/design-jsx/src/ packages/design-jsx/tests/ packages/design-jsx/scripts/ packages/emit/src/ packages/emit/tests/ packages/emit/scripts/ packages/kiwi/src/ packages/kiwi/tests/ packages/kiwi/scripts/ packages/fig/src/ packages/fig/tests/ packages/fig/scripts/ packages/core/tests/ packages/cli/tests/ packages/scene-graph/tests/ packages/vue/tests/ tests/ scripts/ tools/ packages/docs/.vitepress/theme/landing/ packages/motion/src/ packages/motion/tests/ packages/motion/scripts/ packages/plugin-contracts/src/ packages/plugin-contracts/tests/ packages/plugin-contracts/scripts/ packages/lowcode/src/ packages/lowcode/tests/ packages/lowcode/scripts/ packages/motion-runtime/src/ packages/motion-runtime/tests/ packages/marketplace/src/ packages/figma-motion-plugin/src/ packages/figma-motion-plugin/tests/ packages/compiler/src/ packages/compiler/tests/ packages/backend-compiler-sidecar/src/ packages/backend-compiler-sidecar/scripts/ packages/backend-compiler-sidecar/tests/ packages/codepen-sidecar/src/ packages/codepen-sidecar/scripts/ packages/codepen-sidecar/tests/",
    "format": "oxfmt --write .oxfmtrc.json commitlint.config.ts vite.config.ts vite/ .storybook/ src/ packages/scene-graph/src/ packages/scene-graph/scripts/ packages/core/src/ packages/cli/src/ packages/mcp/src/ packages/harness/src/ packages/harness/tests/ packages/feedback/src/ packages/feedback/tests/ packages/vue/src/ packages/dom-css/src/ packages/dom-css/tests/ packages/dom-css/scripts/ packages/pen/src/ packages/pen/scripts/ packages/design-jsx/src/ packages/design-jsx/tests/ packages/design-jsx/scripts/ packages/emit/src/ packages/emit/tests/ packages/emit/scripts/ packages/kiwi/src/ packages/kiwi/tests/ packages/kiwi/scripts/ packages/fig/src/ packages/fig/tests/ packages/fig/scripts/ tests scripts/ tools/ packages/docs/.vitepress/theme/landing/ packages/motion/src/ packages/motion/tests/ packages/motion/scripts/ packages/plugin-contracts/src/ packages/plugin-contracts/tests/ packages/plugin-contracts/scripts/ packages/lowcode/src/ packages/lowcode/tests/ packages/lowcode/scripts/ packages/motion-runtime/src/ packages/motion-runtime/tests/ packages/marketplace/src/ packages/vue/tests/ packages/figma-motion-plugin/src/ packages/figma-motion-plugin/tests/ packages/compiler/src/ packages/compiler/tests/ packages/backend-compiler-sidecar/src/ packages/backend-compiler-sidecar/scripts/ packages/backend-compiler-sidecar/tests/ packages/codepen-sidecar/src/ packages/codepen-sidecar/scripts/ packages/codepen-sidecar/tests/ packages/core/tests/ packages/scene-graph/tests/",
    "format:check": "bun run format && status=$(git status --porcelain -uall) && test -z \"$status\" || (echo \"$status\" && exit 1)",
    "check": "bun run check:icons && bun run build:packages && bun run lint && bun run typecheck && bun run check:native-test && bun run check:i18n && bun run check:docs && bun run check:changelog && bun run check:packages && bun run check:figma-motion-plugin && bun run check:deps && bun run check:audit && bun run check:secrets && bun run check:monorepo && bun run check:arch && bun run check:test-homes && bun run check:test-types && bun run check:tools && bun run test:type-shapes && bun run test:tools && bun run test:dupes",
    "check:commits": "commitlint",
    "check:changelog": "bun tools/release/release-packages/src/changelog/check.ts --release",
    "changelog:assemble": "bun tools/release/release-packages/src/changelog/assemble.ts",
    "check:deps": "knip --include unlisted,unresolved,binaries",
    "check:docs": "bun --filter @open-pencil/docs check && bun run check:authoring-reference",
    "check:authoring-reference": "bun tools/generate/authoring-reference/src/check.ts",
    "generate:authoring-reference": "bun tools/generate/authoring-reference/src/generate.ts",
    "check:audit": "bun audit --audit-level=critical",
    "check:secrets": "bun tools/checks/secret-scan/src/index.ts",
    "check:monorepo": "sherif --ignore-rule root-package-dependencies --ignore-dependency 'tailwind-merge@^2.5.5' --ignore-dependency 'vue-router@^4.6.4'",
    "check:native-test": "tsc --noEmit -p tests/e2e/native/tsconfig.json && tsc --noEmit -p tests/e2e/native-collab/tsconfig.json",
    "check:i18n": "bun tools/checks/i18n/src/check-locales.ts",
    "check:packages": "bun tools/checks/package-quality/src/cli.ts check",
    "check:arch": "CHOKIDAR_USEPOLLING=1 steiger .",
    "check:test-homes": "bun tools/checks/test-homes/src/index.ts",
    "check:test-types": "bun tools/checks/test-types/src/index.ts",
    "check:vue": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p packages/vue/tsconfig.json",
    "test": "OPENPENCIL_TEST_SERVER=app playwright test --project=openpencil --grep-invert @real-llm",
    "test:storybook": "OPENPENCIL_TEST_SERVER=storybook playwright test --project=storybook-chromium",
    "test:real-llm": "OPENPENCIL_TEST_SERVER=app playwright test --project=openpencil --grep @real-llm",
    "test:update": "OPENPENCIL_TEST_SERVER=app playwright test --project=openpencil --update-snapshots",
    "test:figma": "OPENPENCIL_TEST_SERVER=app playwright test --project=figma",
    "figma:debug": "open -a Figma --args --remote-debugging-port=9222",
    "typecheck": "tsgo --noEmit && bun run check:scene-graph && bun run check:vue",
    "test:unit": "bun tools/dev/unit-tests/src/run.ts all --include-heavy",
    "test:unit:quick": "bun tools/dev/unit-tests/src/run.ts all",
    "test:unit:isolated": "bun tools/dev/unit-tests/src/run.ts all --isolate",
    "test:unit:heavy": "bun tools/dev/unit-tests/src/heavy.ts",
    "test:coverage": "bun tools/dev/unit-tests/src/run.ts all --include-heavy -- --coverage",
    "test:type-shapes": "bun tools/checks/type-shapes/src/index.ts",
    "test:tools": "bun --filter '@open-pencil/*-tools' test && bun --filter @open-pencil/harness test",
    "test:feedback": "bun --filter @open-pencil/feedback typecheck && bun --filter @open-pencil/feedback check:types && bun --filter @open-pencil/feedback test",
    "test:dupes": "jscpd packages/scene-graph/src packages/pen/src packages/design-jsx/src packages/emit/src packages/core/src packages/cli/src packages/feedback/src packages/dom-css/src packages/fig/src src packages/motion/src packages/plugin-contracts/src packages/lowcode/src packages/harness/src packages/marketplace/src packages/compiler/src --min-lines 5 --min-tokens 50 --format typescript --threshold 0",
    "test:packages": "bun tools/release/release-packages/src/cli.ts verify",
    "build:packages": "bun tools/release/package-artifacts/src/build.ts && bun --filter @open-pencil/marketplace build && bun --filter @open-pencil/compiler build && bun --filter @open-pencil/backend-compiler-sidecar build && bun --filter @open-pencil/codepen-sidecar build && bun --filter @open-pencil/figma-motion-plugin build",
    "open-pencil": "bun packages/cli/src/index.ts",
    "docs:dev": "bun --filter @open-pencil/docs dev",
    "docs:build": "bun --filter @open-pencil/docs build",
    "docs:build:production": "bun --filter @open-pencil/docs build:production",
    "docs:preview": "bun --filter @open-pencil/docs preview",
    "generate:demo": "bun tools/generate/demo/src/cli.ts --force",
    "generate:landing-posters": "bun tools/generate/landing-posters/src/generate.ts --force",
    "generate:icons": "bun tools/generate/brand/src/cli.ts generate",
    "check:icons": "bun tools/generate/brand/src/cli.ts check",
    "generate:tauri-menu": "bun tools/generate/tauri-menu/src/generate.ts",
    "check:tools": "tsgo --noEmit -p tools/tsconfig.json",
    "test:native:collab": "bun run build:native-test && wdio run wdio.native-collab.conf.ts",
    "check:figma-motion-plugin": "bun --filter @open-pencil/figma-motion-plugin check",
    "check:scene-graph": "bun --filter @open-pencil/scene-graph typecheck",
    "build:backend-compiler-sidecar": "bun packages/backend-compiler-sidecar/scripts/build.ts",
    "smoke:backend-compiler-sidecar": "bun packages/backend-compiler-sidecar/scripts/smoke.ts",
    "build:codepen-sidecar": "bun packages/codepen-sidecar/scripts/build.ts",
    "smoke:codepen-sidecar": "bun packages/codepen-sidecar/scripts/smoke.ts",
    "marketplace": "bun packages/marketplace/src/cli.ts",
    "marketplace:serve": "bun packages/marketplace/src/cli.ts serve",
    "visual-compare": "bun tools/generate/visual-oracles/src/cli.ts compare",
    "tauri:automation:dev": "tauri dev --config desktop/tauri.automation.conf.json",
    "mcp:tauri": "mcp-server-tauri",
    "tauri:mcp:session": "tauri-mcp driver-session start --port 9223",
    "tauri:mcp:screenshot": "tauri-mcp webview-screenshot --file test-results/tauri-mcp-screenshot.png",
    "tauri:mcp:lowcode-preview-ack": "bun tools/dev/lowcode/src/tauri-lowcode-preview-ack-cli.ts",
    "tauri:webdriver": "tauri-wd --port 4444",
    "tauri:webdriver:install": "cargo install tauri-webdriver-automation",
    "figma:web:debug": "open -na \"Google Chrome\" --args --remote-debugging-port=9222 '--remote-allow-origins=*' --user-data-dir=/private/tmp/figma-cdp-profile https://www.figma.com/files/recent"
