{
  "format": "openpencil-plugin",
  "schemaVersion": 2,
  "plugin": {
    "id": "example.document-summary",
    "name": "Document Summary",
    "version": "1.0.0"
  },
  "publisher": {
    "id": "example-publisher",
    "name": "Example Publisher",
    "keyId": "example-publisher-2026"
  },
  "engineRange": ">=0.15.0 <1.0.0",
  "capabilities": [],
  "contributions": {
    "modules": [],
    "commands": [
      {
        "commandId": "summarize-document",
        "name": "Summarize document",
        "description": "Return bounded aggregate page, node, and selection counts without document content.",
        "adapterId": "open-pencil.example.document-summary",
        "parameters": {
          "schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false,
            "maxProperties": 0
          },
          "maxBytes": 2
        },
        "result": {
          "schema": {
            "type": "object",
            "properties": {
              "pageCount": {
                "type": "integer",
                "minimum": 0
              },
              "nodeCount": {
                "type": "integer",
                "minimum": 0
              },
              "selectedNodeCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["pageCount", "nodeCount", "selectedNodeCount"],
            "additionalProperties": false,
            "maxProperties": 3
          },
          "maxBytes": 256
        },
        "permissions": ["document.read", "document.selection.read"]
      }
    ]
  }
}
