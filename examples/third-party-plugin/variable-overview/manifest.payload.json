{
  "format": "openpencil-plugin",
  "schemaVersion": 2,
  "plugin": {
    "id": "example.variable-overview",
    "name": "Variable Overview",
    "version": "1.0.0"
  },
  "publisher": {
    "id": "example-publisher",
    "name": "Example Publisher",
    "keyId": "example-publisher-2026"
  },
  "engineRange": ">=0.15.0 <1.0.0",
  "capabilities": [],
  "contributions": {
    "modules": [],
    "commands": [
      {
        "commandId": "summarize-variables",
        "name": "Summarize variables",
        "description": "Return bounded aggregate collection, variable, mode, and publishing counts without names or values.",
        "adapterId": "open-pencil.example.variable-overview",
        "parameters": {
          "schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false,
            "maxProperties": 0
          },
          "maxBytes": 2
        },
        "result": {
          "schema": {
            "type": "object",
            "properties": {
              "collectionCount": { "type": "integer", "minimum": 0 },
              "variableCount": { "type": "integer", "minimum": 0 },
              "modeCount": { "type": "integer", "minimum": 0 },
              "publishableVariableCount": { "type": "integer", "minimum": 0 }
            },
            "required": [
              "collectionCount",
              "variableCount",
              "modeCount",
              "publishableVariableCount"
            ],
            "additionalProperties": false,
            "maxProperties": 4
          },
          "maxBytes": 256
        },
        "permissions": ["document.variables.read"]
      }
    ]
  }
}
